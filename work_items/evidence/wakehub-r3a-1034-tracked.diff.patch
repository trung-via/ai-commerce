+def test_r3a_cli_is_opt_in_dry_run_and_synthetic_modes_stay_separate(r3a_ingress, monkeypatch, capsys):
+    i = r3a_ingress
+    args = ["run", "--config", str(i["config_path"]), "--repository-root", str(i["root"])]
