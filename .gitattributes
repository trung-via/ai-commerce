* text=auto
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.docx binary
*.png binary

# GitHub-published EF02 evidence JSON may contain literal CRLF bytes.
# Preserve raw evidence bytes/hashes; never silently normalize in Git for Windows.
examples/*/evidence/*.json -text -eol

# EF01-R/Codex verification artifacts are immutable, sometimes native Windows CRLF.
# Do not re-filter their original Git blob bytes when EF02 checks out a candidate.
**/repair_evidence/*.json -text -eol
