* text=auto
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.docx binary
*.png binary

# GitHub-published EF02 evidence JSON may contain literal CRLF bytes.
# Preserve raw evidence bytes/hashes; never silently normalize in Git for Windows.
examples/*/evidence/*.json -text -eol

# EF01-R and phase-specific generated *_evidence JSON can contain native Windows CRLF.
# Preserve the exact verified Git blob bytes when later EF02 actions check out candidates.
# This covers repair_evidence, a12_02_evidence and future named action evidence dirs.
**/*_evidence/*.json -text -eol
