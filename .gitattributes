# Source files retain explicit text rules; GitHub API candidate blobs are raw bytes.
* text=auto
*.md text eol=lf
# JSON is byte-stable at Git checkout (EF02 publishes the verified raw JSON bytes).
# Validate JSON content/authoring LF with tests rather than rewriting during checkout.
*.json -text -eol
*.ps1 text eol=crlf
*.docx binary
*.png binary
