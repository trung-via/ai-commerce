* text=auto
*.md text eol=lf
*.json -text -eol
*.py -text -eol
*.ps1 text eol=crlf
*.docx binary
*.png binary

# GitHub-published EF02 evidence JSON may contain literal CRLF bytes.
# Preserve raw evidence bytes/hashes; never silently normalize in Git for Windows.
examples/*/evidence/*.json -text -eol

# Raw EF01-R evidence may contain CRLF; preserve immutable verified bytes across OS.
**/*_evidence/*.json -text -eol

# Product v1 contracts generated by EF02 candidates may retain native CRLF JSON.
# Keep exact vetted Git blob bytes; JSON validity remains schema-tested, not auto-licensed.
contracts/Product*.v1.schema.json -text -eol
