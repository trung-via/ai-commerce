          "complete": {
            "const": false
          },
          "provider_charge_verified": {
            "const": false
          }
        },
        "required": [
          "currency",
          "estimated",
          "supplied_charged",
          "synthetic_charged",
          "pending_count",
          "unknown_count",
          "complete",
          "provider_charge_verified"
        ]
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_tier": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "UNKNOWN",
            "NOT_AVAILABLE"
          ]
        },
        "reviews": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "scope_link": {
                "enum": [
                  "MATCHED",
                  "PARTIAL",
                  "UNLINKED",
                  "MISMATCH"
                ]
              },
              "tiers": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "UNKNOWN",
                    "NOT_AVAILABLE"
                  ]
                }
              }
            },
            "required": [
              "source_id",
              "scope_link",
              "tiers"
            ]
          }
        },
        "settlement_status": {
          "const": "UNVERIFIED"
        },
        "paid_proof_verified": {
          "const": false
        }
      },
      "required": [
        "declared_tier",
        "reviews",
        "settlement_status",
        "paid_proof_verified"
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 96,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "missingness": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "counterevidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "source_id",
          "code"
        ]
      }
    },
    "assumptions": {
      "const": [
        "OFFLINE_ONLY: supplied and synthetic facts cannot prove live outcomes or market feasibility.",
        "Confidence is an evidence rating, never a probability of success.",
        "Local custody and hashes do not authenticate providers, receipts, rights or Human identity.",
        "No causal uplift, ranked ROI, realized profit or verified settlement is inferred.",
        "Cost job identity does not establish campaign allocation; currencies are never converted.",
        "KEEP/CHANGE/STOP can be provisional Human advice on complete replayed user-supplied performance under an explicit provisional policy; never provider-verified outcomes.",
        "Human policy is editable data; all actions require a separate Human decision."
      ]
    },
    "human_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "GATHER_COMPARABLE_EVIDENCE",
            "REVIEW_CONFLICTS",
            "REVIEW_PROVISIONAL_RECOMMENDATION"
          ]
        },
        "proposed_only": {
          "const": true
        },
        "execution_authority": {
          "const": "NONE"
        }
      },
      "required": [
        "kind",
        "proposed_only",
        "execution_authority"
      ]
    },
    "downstream_use": {
      "const": "HUMAN_OR_A18_2_VERSIONED_REFERENCE_ONLY"
    },
    "financial_commitment": {
      "const": "NONE"
    },
    "live_outcome_verified": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "recommendation_id",
    "evaluator_version",
    "source_sha",
    "request",
    "request_sha256",
    "policy_sha256",
    "decision",
    "evidence_quality",
    "confidence",
    "confidence_meaning",
    "sources",
    "measurements",
    "comparisons",
    "costs",
    "cost_totals",
    "attribution",
    "reason_codes",
    "missingness",
    "counterevidence",
    "assumptions",
    "human_action",
    "downstream_use",
    "financial_commitment",
    "live_outcome_verified"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "KEEP",
              "CHANGE",
              "STOP"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "PROVISIONAL_USER_SUPPLIED_UNATTESTED"
          },
          "human_action": {
            "properties": {
              "kind": {
                "const": "REVIEW_PROVISIONAL_RECOMMENDATION"
              }
            }
          },
          "request": {
            "properties": {
              "human_policy": {
                "type": "object",
                "properties": {
                  "requirement": {
                    "const": "PROVISIONAL_LOCAL_DESCRIPTIVE"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "INCONCLUSIVE"
          }
        }
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "INSUFFICIENT_FOR_DECISIVE_RECOMMENDATION"
          }
        }
      }
    }
  ]
}
