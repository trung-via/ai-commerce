{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-commerce:CreativeFeedbackProposal:v1",
  "title": "CreativeFeedbackProposal.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "CreativeFeedbackProposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "parent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
            }
          },
          "required": [
            "id",
            "revision",
            "sha256",
            "ref"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "batch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "master_id": {
      "type": "string",
      "pattern": "^a17\\-master\\-[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "MASTER",
            "VARIANT"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ]
    },
    "source_brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256",
        "ref"
      ]
    },
    "next_brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256",
        "ref"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "TIKTOK",
            "YOUTUBE",
            "FACEBOOK",
            "INSTAGRAM"
          ]
        },
        "surface": {
          "enum": [
            "VIDEO",
            "PROFILE_VIDEO",
            "SHORT",
            "PAGE_REEL",
            "REEL"
          ]
        },
        "account_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "const": "internal_alias"
            },
            "id": {
              "type": "string",
              "pattern": "^a11\\-account\\-[a-f0-9]{64}$"
            }
          },
          "required": [
            "namespace",
            "id"
          ]
        },
        "measurement_window": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "description": "Explicit instants: start inclusive, end exclusive; never a default period."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cohort": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "market": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"
        }
      },
      "required": [
        "platform",
        "surface",
        "account_ref",
        "measurement_window",
        "timezone",
        "cohort",
        "market"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "TIKTOK"
              }
            }
          },
          "then": {
            "properties": {
              "account_ref": {
                "properties": {
                  "namespace": {
                    "enum": [
                      "tiktok_open_id",
                      "internal_alias"
                    ]
                  }
                }
              },
              "surface": {
                "enum": [
                  "VIDEO",
                  "PROFILE_VIDEO"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "YOUTUBE"
              }
            }
          },
          "then": {
            "properties": {
              "account_ref": {
                "properties": {
                  "namespace": {
                    "enum": [
                      "youtube_channel_id",
                      "internal_alias"
                    ]
                  }
                }
              },
              "surface": {
                "enum": [
                  "VIDEO",
                  "SHORT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "FACEBOOK"
              }
            }
          },
          "then": {
            "properties": {
              "account_ref": {
                "properties": {
                  "namespace": {
                    "enum": [
                      "facebook_page_id",
                      "internal_alias"
                    ]
                  }
                }
              },
              "surface": {
                "enum": [
                  "PAGE_REEL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "platform": {
                "const": "INSTAGRAM"
              }
            }
          },
          "then": {
            "properties": {
              "account_ref": {
                "properties": {
                  "namespace": {
                    "enum": [
                      "instagram_user_id",
                      "internal_alias"
                    ]
                  }
                }
              },
              "surface": {
                "enum": [
                  "REEL"
                ]
              }
            }
          }
        }
      ]
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_id": {
          "type": "string",
          "pattern": "^a11\\-advisory\\-[a-f0-9]{64}$"
        },
        "archive_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "head_event_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learning_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "revision_id": {
          "type": "string",
          "pattern": "^a11\\-revision\\-[a-f0-9]{64}$"
        },
        "context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "export_id",
        "archive_ref",
        "archive_sha256",
        "event_count",
        "head_event_hash",
        "learning_key",
        "revision",
        "revision_id",
        "context_ref",
        "context_sha256"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^a11\\-evidence\\-[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "negative_evidence_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^a11\\-evidence\\-[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "suggestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_window": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "description": "Explicit instants: start inclusive, end exclusive; never a default period."
        },
        "after_window": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "description": "Explicit instants: start inclusive, end exclusive; never a default period."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "cohort": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "MetricDefinition.v1"
            },
            "metric_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "provider_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "definition_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "platform": {
              "enum": [
                "TIKTOK",
                "YOUTUBE",
                "FACEBOOK",
                "INSTAGRAM"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "definition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "denominator": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 512
            },
            "cohort": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "comparison_policy": {
              "const": "NO_CROSS_PROVIDER_EQUIVALENCE"
            },
            "source_status": {
              "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
            }
          },
          "required": [
            "schema_version",
            "metric_key",
            "provider_name",
            "definition_version",
            "platform",
            "unit",
            "definition",
            "denominator",
            "cohort",
            "comparison_policy",
            "source_status"
          ]
        },
        "before": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^a11\\-evidence\\-[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "AVAILABLE",
                  "UNKNOWN"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1e+100,
                "maximum": 1e+100
              },
              "denominator": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1e+100,
                "maximum": 1e+100
              },
              "provenance": {
                "enum": [
                  "USER_SUPPLIED",
                  "SYNTHETIC_FIXTURE"
                ]
              }
            },
            "required": [
              "evidence_id",
              "status",
              "value",
              "denominator",
              "provenance"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "AVAILABLE"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "UNKNOWN"
            },
            "value": {
              "type": "null"
            },
            "denominator": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "value",
            "denominator"
          ]
        },
        "causal_lift": {
          "type": "null"
        },
        "trend": {
          "const": "NOT_ESTABLISHED"
        }
      },
      "required": [
        "before_window",
        "after_window",
        "timezone",
        "cohort",
        "metric",
        "before",
        "after",
        "causal_lift",
        "trend"
      ]
    },
    "missing_data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "provenance": {
      "const": "DETERMINISTIC_LOCAL_PROPOSAL"
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "PENDING",
            "ACCEPTED",
            "DECLINED"
          ]
        },
        "actor": {
          "enum": [
            null,
            "HUMAN"
          ]
        },
        "note": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "actor",
        "note"
      ]
    },
    "inference": {
      "const": "HYPOTHESIS_ONLY"
    },
    "generation_authorization": {
      "const": "REQUIRED_SEPARATELY"
    },
    "generation_performed": {
      "const": false
    },
    "publication_status": {
      "const": "NOT_ATTEMPTED"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "revision",
    "parent",
    "batch_id",
    "batch_sha256",
    "master_id",
    "source",
    "source_brief",
    "next_brief",
    "scope",
    "advisory",
    "evidence_ids",
    "negative_evidence_ids",
    "suggestion",
    "hypothesis",
    "uncertainty",
    "comparison",
    "missing_data",
    "provenance",
    "adoption",
    "inference",
    "generation_authorization",
    "generation_performed",
    "publication_status",
    "record_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "parent": {
            "type": "null"
          },
          "adoption": {
            "properties": {
              "decision": {
                "const": "PENDING"
              },
              "actor": {
                "type": "null"
              },
              "note": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256",
              "ref"
            ]
          },
          "adoption": {
            "properties": {
              "decision": {
                "enum": [
                  "ACCEPTED",
                  "DECLINED"
                ]
              },
              "actor": {
                "const": "HUMAN"
              }
            }
          }
        }
      }
    }
  ]
}
