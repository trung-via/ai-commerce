      }
    },
    "registry_event_refs": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^a12-event-[a-f0-9]{64}$"
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
