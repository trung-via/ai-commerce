                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                          }
                        },
                        "valid_from": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
                          "format": "date-time"
                        },
                        "valid_until": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "territories",
                        "media_types",
                        "channels",
                        "valid_from",
                        "valid_until"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reviewed": {
                  "type": "boolean"
                }
              },
              "required": [
                "purpose",
                "declared_status",
                "status",
                "license_ref",
                "scope",
