    "generated_at"
  ],
  "$defs": {
    "ProductSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^a12-snapshot-[a-f0-9]{64}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^a12-source-[a-f0-9]{64}$"
        },
        "snapshot_raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "source_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
        },
        "identity_id": {
          "type": "string",
          "pattern": "^a12-identity-[a-f0-9]{64}$"
        },
        "variant_record_id": {
          "type": "string",
          "pattern": "^a12-variant-record-[a-f0-9]{64}$"
        },
        "seller_id": {
          "type": "string",
          "pattern": "^a12-seller-[a-f0-9]{64}$"
        },
        "listing_id": {
          "type": "string",
          "pattern": "^a12-listing-[a-f0-9]{64}$"
        },
        "product_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a12-product-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a12-variant-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_id",
        "source_snapshot_id",
        "snapshot_raw_sha256",
        "ordinal",
        "source_namespace",
        "identity_id",
        "variant_record_id",
        "seller_id",
        "listing_id",
        "product_id",
        "variant_id",
        "variant_key",
        "synthetic"
      ]
    },
    "ProductEvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "source_kind": {
          "enum": [
            "HUMAN_SUPPLIED",
            "PREEXPORTED_API"
          ]
        },
        "source_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "raw_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "pointer": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "source_ref",
        "source_kind",
        "source_status",
        "captured_at",
        "raw_sha256",
        "raw_ref",
        "raw_size_bytes",
        "pointer"
      ]
    }
  }
}
