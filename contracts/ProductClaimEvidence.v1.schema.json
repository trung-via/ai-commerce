{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-commerce:ProductClaimEvidence:v1",
  "title": "ProductClaimEvidence.v1",
  "description": "A12 offline evidence; source and report authenticity are not externally attested. Content ID hashes canonical JSON excluding its own ID. Validation requires the exact raw evidence and pinned A12-01 snapshot; independent claim status also requires separate evidence bytes and explicit scoped reviewer proof. Amounts are strict nonnegative decimal strings, never binary floats. No live price, affiliate eligibility, rights grant or publication is implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ProductClaimEvidence.v1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^a12-claim-[a-f0-9]{64}$"
    },
    "source_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "verification_scope": {
      "const": "LOCAL_BYTES_HASH_AND_REPLAY_ONLY"
    },
    "rights_status": {
      "const": "UNKNOWN"
    },
    "publication_status": {
      "const": "NOT_ATTEMPTED"
    },
    "subject": {
      "$ref": "#/$defs/ProductSubject"
    },
    "source": {
      "$ref": "#/$defs/ProductEvidenceSource"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
        },
        "category": {
          "enum": [
            "ATTRIBUTE",
            "PERFORMANCE",
            "SAFETY",
            "COMPOSITION",
            "ORIGIN",
            "COMPATIBILITY",
            "WARRANTY",
            "OTHER"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 4096,
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        "unit": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "SELLER",
            "OBSERVER",
            "ILLUSTRATION",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "role": {
          "enum": [
            "SUPPORTING",
            "COUNTEREVIDENCE",
            "INCONCLUSIVE"
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^a12-claim-[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "claim_key",
        "category",
        "statement",
        "value",
        "unit",
        "origin",
        "role",
        "observed_at",
        "conflict_refs"
      ]
    },
    "status": {
      "enum": [
        "SOURCE_OBSERVED",
        "SELLER_ASSERTED",
        "INDEPENDENTLY_VERIFIED_ONLY_WITH_REAL_EVIDENCE",
        "ILLUSTRATIVE",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "reviewer_proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "producer_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "reviewed_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "format": "date-time"
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "evidence_kind": {
              "enum": [
                "INDEPENDENT_TEST_REPORT",
                "INDEPENDENT_CERTIFICATE",
                "INDEPENDENT_MEASUREMENT"
              ]
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence_ref_sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "evidence_size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "claim_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "conclusion": {
              "const": "SUPPORTS"
            },
            "verification_scope": {
              "const": "EXPLICIT_REVIEW_OF_LOCAL_EVIDENCE_ONLY"
            }
          },
          "required": [
            "reviewer_ref",
            "producer_ref",
            "method",
            "reviewed_at",
            "evidence_ref",
            "evidence_kind",
            "evidence_sha256",
            "evidence_ref_sha256",
            "evidence_size_bytes",
            "claim_sha256",
            "conclusion",
            "verification_scope"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "source_status",
    "verification_scope",
    "rights_status",
    "publication_status",
    "subject",
    "source",
    "claim",
    "status",
    "reviewer_proof"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "INDEPENDENTLY_VERIFIED_ONLY_WITH_REAL_EVIDENCE"
          }
        }
      },
      "then": {
        "properties": {
          "reviewer_proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "producer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
                "format": "date-time"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "evidence_kind": {
                "enum": [
                  "INDEPENDENT_TEST_REPORT",
                  "INDEPENDENT_CERTIFICATE",
                  "INDEPENDENT_MEASUREMENT"
                ]
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_ref_sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "evidence_size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "claim_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "conclusion": {
                "const": "SUPPORTS"
              },
              "verification_scope": {
                "const": "EXPLICIT_REVIEW_OF_LOCAL_EVIDENCE_ONLY"
              }
            },
            "required": [
              "reviewer_ref",
              "producer_ref",
              "method",
              "reviewed_at",
              "evidence_ref",
              "evidence_kind",
              "evidence_sha256",
              "evidence_ref_sha256",
              "evidence_size_bytes",
              "claim_sha256",
              "conclusion",
              "verification_scope"
            ]
          },
          "subject": {
            "properties": {
              "synthetic": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reviewer_proof": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONFLICT"
          }
        }
      },
      "then": {
        "properties": {
          "claim": {
            "properties": {
              "conflict_refs": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^a12-claim-[a-f0-9]{64}$"
                },
                "minItems": 2
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ProductSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^a12-snapshot-[a-f0-9]{64}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^a12-source-[a-f0-9]{64}$"
        },
        "snapshot_raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "source_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
        },
        "identity_id": {
          "type": "string",
          "pattern": "^a12-identity-[a-f0-9]{64}$"
        },
        "variant_record_id": {
          "type": "string",
          "pattern": "^a12-variant-record-[a-f0-9]{64}$"
        },
        "seller_id": {
          "type": "string",
          "pattern": "^a12-seller-[a-f0-9]{64}$"
        },
        "listing_id": {
          "type": "string",
          "pattern": "^a12-listing-[a-f0-9]{64}$"
        },
        "product_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a12-product-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a12-variant-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_key": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_id",
        "source_snapshot_id",
        "snapshot_raw_sha256",
        "ordinal",
        "source_namespace",
        "identity_id",
        "variant_record_id",
        "seller_id",
        "listing_id",
        "product_id",
        "variant_id",
        "variant_key",
        "synthetic"
      ]
    },
    "ProductEvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "source_kind": {
          "enum": [
            "HUMAN_SUPPLIED",
            "PREEXPORTED_API"
          ]
        },
        "source_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?!.*-00:00$)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "raw_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "pointer": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "source_ref",
        "source_kind",
        "source_status",
        "captured_at",
        "raw_sha256",
        "raw_ref",
        "raw_size_bytes",
        "pointer"
      ]
    }
  }
}
