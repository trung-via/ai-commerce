                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                  "minLength": 1,
                  "maxLength": 96
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                  "minLength": 1,
                  "maxLength": 96
                }
              },
              "required": [
                "namespace",
                "id"
              ]
            },
            "market": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "maxLength": 2
            },
            "package_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
              "minLength": 1,
              "maxLength": 96
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "media_type": {
              "const": "video/mp4"
            }
          },
          "required": [
            "platform",
            "surface",
            "account_ref",
            "app_ref",
            "market",
            "package_id",
            "package_sha256",
            "content_sha256",
            "media_type"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "outcome": {
          "enum": [
            "UNKNOWN",
            "CONFIRMED",
            "NO_EFFECT",
            "AMBIGUOUS"
          ]
        },
        "provenance": {
          "const": "SYNTHETIC_FIXTURE"
        },
        "provider_attested": {
          "const": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "receipt_sha256",
        "target",
        "source_sha256",
        "outcome",
        "provenance",
        "provider_attested"
      ]
    },
    "Denial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "DirectPostDenial.v1"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "reason": {
          "enum": [
