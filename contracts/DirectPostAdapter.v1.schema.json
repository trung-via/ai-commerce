  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Consent"
    },
    {
      "$ref": "#/$defs/Capability"
    },
    {
      "$ref": "#/$defs/Intent"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Callback"
    },
    {
