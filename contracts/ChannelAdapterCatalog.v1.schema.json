        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_+./-]*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "RECORDED_SYNTHETIC"
          ]
        },
        "attribution_tier": {
          "enum": [
            "NONE",
            "UNVERIFIED"
          ]
        },
        "currency": {
