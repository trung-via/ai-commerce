                      "minLength": 1,
                      "maxLength": 96
                    },
                    "definition": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                      "minLength": 1,
                      "maxLength": 96
                    },
                    "denominator": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                      "minLength": 1,
                      "maxLength": 96
                    },
                    "unit": {
                      "const": "COUNT"
                    },
                    "visibility_meaning": {
                      "const": "UNKNOWN"
                    },
                    "namespace": {
                      "enum": [
                        "TIKTOK",
                        "INSTAGRAM",
                        "YOUTUBE"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "definition",
                    "denominator",
                    "unit",
                    "visibility_meaning",
                    "namespace"
