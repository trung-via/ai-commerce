    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ChannelAdapterCatalog.v1"
        },
        "version": {
          "const": "a17-3/1.0"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform": {
                "enum": [
                  "TIKTOK",
                  "INSTAGRAM",
                  "YOUTUBE"
                ]
              },
              "adapter_namespace": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                "minLength": 1,
                "maxLength": 96
              },
              "adapter_version": {
                "const": "a17-3/1.0"
              },
              "surface": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                "minLength": 1,
                "maxLength": 96
              },
              "account_namespace": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                "minLength": 1,
                "maxLength": 96
              },
              "app_namespace": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
                "minLength": 1,
                "maxLength": 96
              },
              "a07_action": {
                "enum": [
                  "API_DIRECT_POST",
                  "API_UPLOAD"
                ]
              },
              "provenance": {
                "const": "SYNTHETIC_FIXTURE"
              },
              "live_available": {
                "const": false
              },
              "receipt_semantics": {
                "const": "SYNTHETIC_CONFIRMATION_IS_NOT_PUBLICATION"
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
