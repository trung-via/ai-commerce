{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/SignalSourceSnapshot.v1",
  "title": "SignalSourceSnapshot.v1",
  "description": "A10 offline SignalSourceSnapshot contract. User-supplied; never live-provider verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SignalSourceSnapshot.v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "collected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rights_status": {
      "enum": [
        "UNKNOWN",
        "USER_DECLARED_PERMITTED",
        "USER_DECLARED_RESTRICTED",
        "NOT_APPLICABLE"
      ]
    },
    "verification_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "geo": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "locale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "terms_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "source_ref",
    "captured_at",
    "sha256",
    "rights_status",
    "verification_status"
  ],
  "$defs": {}
}
