{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/PerformanceObservation.v1",
  "title": "PerformanceObservation.v1",
  "description": "A09 offline manual analytics. User-supplied; never live-provider verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "PerformanceObservation.v1"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^obs-[a-f0-9]{64}$"
    },
    "import_id": {
      "type": "string",
      "pattern": "^a09-[a-f0-9]{64}$"
    },
    "platform": {
      "enum": [
        "TIKTOK",
        "YOUTUBE",
        "FACEBOOK",
        "INSTAGRAM"
      ]
    },
    "surface": {
      "enum": [
        "VIDEO",
        "PROFILE_VIDEO",
        "SHORT",
        "PAGE_REEL",
        "REEL"
      ]
    },
    "account_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "internal_alias",
            "tiktok_open_id",
            "youtube_channel_id",
            "facebook_page_id",
            "instagram_user_id"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "namespace",
        "id"
      ]
    },
    "measurement_window": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "format": "date-time",
        "maxLength": 64
      },
      "description": "Explicit instants: start inclusive, end exclusive; never a default period."
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cohort": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "provider_post_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "public_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    },
    "metric": {
      "$ref": "#/$defs/MetricDefinition"
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "NOT_AVAILABLE"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1e+100,
      "maximum": 1e+100
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10001
        },
        "source_row_semantics": {
          "enum": [
            "CSV_LOGICAL_RECORD_INCLUDING_HEADER",
            "JSON_ROWS_ONE_BASED"
          ]
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter_version": {
          "const": "manual-analytics.v1"
        },
        "source_kind": {
          "enum": [
            "USER_AUTHORED_MANUAL",
            "USER_PROVIDED_PLATFORM_EXPORT",
            "SYNTHETIC_FIXTURE"
          ]
        },
        "source_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        }
      },
      "required": [
        "raw_sha256",
        "source_row",
        "source_row_semantics",
        "profile_id",
        "mapping_version",
        "adapter_version",
        "source_kind",
        "source_status"
      ]
    },
    "source_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "import_id",
    "platform",
    "surface",
    "account_ref",
    "measurement_window",
    "timezone",
    "cohort",
    "provider_post_id",
    "public_url",
    "metric",
    "status",
    "value",
    "source",
    "source_status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "AVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "TIKTOK"
          }
        }
      },
      "then": {
        "properties": {
          "account_ref": {
            "properties": {
              "namespace": {
                "enum": [
                  "tiktok_open_id",
                  "internal_alias"
                ]
              }
            }
          },
          "surface": {
            "enum": [
              "VIDEO",
              "PROFILE_VIDEO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "YOUTUBE"
          }
        }
      },
      "then": {
        "properties": {
          "account_ref": {
            "properties": {
              "namespace": {
                "enum": [
                  "youtube_channel_id",
                  "internal_alias"
                ]
              }
            }
          },
          "surface": {
            "enum": [
              "VIDEO",
              "SHORT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "FACEBOOK"
          }
        }
      },
      "then": {
        "properties": {
          "account_ref": {
            "properties": {
              "namespace": {
                "enum": [
                  "facebook_page_id",
                  "internal_alias"
                ]
              }
            }
          },
          "surface": {
            "enum": [
              "PAGE_REEL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "INSTAGRAM"
          }
        }
      },
      "then": {
        "properties": {
          "account_ref": {
            "properties": {
              "namespace": {
                "enum": [
                  "instagram_user_id",
                  "internal_alias"
                ]
              }
            }
          },
          "surface": {
            "enum": [
              "REEL"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "MetricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "MetricDefinition.v1"
        },
        "metric_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definition_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "enum": [
            "TIKTOK",
            "YOUTUBE",
            "FACEBOOK",
            "INSTAGRAM"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "cohort": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "comparison_policy": {
          "const": "NO_CROSS_PROVIDER_EQUIVALENCE"
        },
        "source_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        }
      },
      "required": [
        "schema_version",
        "metric_key",
        "provider_name",
        "definition_version",
        "platform",
        "unit",
        "definition",
        "denominator",
        "cohort",
        "comparison_policy",
        "source_status"
      ]
    }
  }
}
