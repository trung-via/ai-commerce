{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/SignalImport.v1",
  "title": "SignalImport.v1",
  "description": "A10 offline SignalImport contract. User-supplied; never live-provider verification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SignalImport.v1"
    },
    "import_id": {
      "type": "string",
      "pattern": "^a10-[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "VALIDATED",
        "IMPORTED"
      ]
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "raw_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "format": {
      "enum": [
        "csv",
        "json"
      ]
    },
    "dialect": {
      "enum": [
        "comma",
        "semicolon",
        "tab",
        null
      ]
    },
    "source_snapshot": {
      "$ref": "#/$defs/SignalSourceSnapshot"
    },
    "mapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "mapping_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "adapter_version": {
              "const": "manual-signal.v1"
            },
            "native_export_layout_verified": {
              "const": false
            },
            "columns": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "required": [
            "profile_id",
            "mapping_version",
            "adapter_version",
            "native_export_layout_verified",
            "columns"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lineage": {
      "$ref": "#/$defs/SignalLineage"
    },
    "signal_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "source_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "import_id",
    "status",
    "raw_sha256",
    "raw_ref",
    "raw_size_bytes",
    "format",
    "source_snapshot",
    "context_sha256",
    "scope_sha256",
    "lineage",
    "signal_count",
    "source_status",
    "recorded_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "json"
          }
        }
      },
      "then": {
        "properties": {
          "dialect": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "dialect": {
            "enum": [
              "comma",
              "semicolon",
              "tab"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "SignalSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "SignalSourceSnapshot.v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_status": {
          "enum": [
            "UNKNOWN",
            "USER_DECLARED_PERMITTED",
            "USER_DECLARED_RESTRICTED",
            "NOT_APPLICABLE"
          ]
        },
        "verification_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "geo": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "locale": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "source_kind",
        "source_ref",
        "captured_at",
        "sha256",
        "rights_status",
        "verification_status"
      ]
    },
    "SignalLineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship": {
          "enum": [
            "ORIGINAL",
            "CORRECTION",
            "REPROCESS"
          ]
        },
        "parent_import_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a10-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relationship",
        "parent_import_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "relationship": {
                "const": "ORIGINAL"
              }
            }
          },
          "then": {
            "properties": {
              "parent_import_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "parent_import_id": {
                "type": "string",
                "pattern": "^a10-[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter_version": {
          "const": "manual-signal.v1"
        },
        "native_export_layout_verified": {
          "const": false
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "profile_id",
        "mapping_version",
        "adapter_version",
        "native_export_layout_verified",
        "columns"
      ]
    }
  }
}
