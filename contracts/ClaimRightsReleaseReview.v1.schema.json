          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "purpose": {
          "enum": [
            "COMMERCIAL_USE",
            "ADVERTISEMENT",
            "CREATIVE_DERIVATIVE"
          ]
        },
        "state": {
          "enum": [
            "NOT_REVOKED",
            "REVOKED",
            "RESTRICTED",
            "UNKNOWN"
          ]
        },
        "issuer_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "source_ref": {
