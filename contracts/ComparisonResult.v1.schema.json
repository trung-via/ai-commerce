{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/ComparisonResult.v1",
  "title": "ComparisonResult.v1",
  "description": "A11 offline advisory evidence. Hashes detect local modification, not external attestation. All fields required except those omitted from required; nullable fields retain explicit unknowns. Content identity is the prefixed SHA256 of canonical JSON without its own ID field.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ComparisonResult.v1"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^a11-comparison-[a-f0-9]{64}$"
    },
    "source_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "left_report_ref": {
      "$ref": "#/$defs/ReportReference"
    },
    "right_report_ref": {
      "$ref": "#/$defs/ReportReference"
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "NOT_AVAILABLE",
        "INSUFFICIENT_DATA",
        "NOT_COMPARABLE"
      ]
    },
    "absolute_change": {
      "$ref": "#/$defs/Measurement"
    },
    "relative_change": {
      "$ref": "#/$defs/Measurement"
    },
    "comparison_policy": {
      "const": "NO_CROSS_PROVIDER_EQUIVALENCE"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "confounders": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Confounder"
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "inference": {
      "const": "DESCRIPTIVE_ONLY"
    }
  },
  "required": [
    "schema_version",
    "comparison_id",
    "source_status",
    "left_report_ref",
    "right_report_ref",
    "status",
    "absolute_change",
    "relative_change",
    "comparison_policy",
    "reason_codes",
    "confounders",
    "caveats",
    "inference"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "NOT_AVAILABLE",
              "INSUFFICIENT_DATA",
              "NOT_COMPARABLE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "absolute_change": {
            "properties": {
              "value": {
                "type": "null"
              },
              "status": {
                "enum": [
                  "NOT_AVAILABLE",
                  "INSUFFICIENT_DATA",
                  "NOT_COMPARABLE"
                ]
              }
            }
          },
          "relative_change": {
            "properties": {
              "value": {
                "type": "null"
              },
              "status": {
                "enum": [
                  "NOT_AVAILABLE",
                  "INSUFFICIENT_DATA",
                  "NOT_COMPARABLE"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Confounder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "status": {
          "enum": [
            "DECLARED",
            "OBSERVED",
            "UNKNOWN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ObservationReference"
          }
        }
      },
      "required": [
        "code",
        "description",
        "status",
        "evidence_refs"
      ]
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "NOT_AVAILABLE",
            "INSUFFICIENT_DATA",
            "NOT_COMPARABLE"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1e+100,
          "maximum": 1e+100
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "numerator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1e+100,
          "maximum": 1e+100
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1e+100,
          "maximum": 1e+100
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "numerator",
        "denominator",
        "reason"
      ],
      "description": "AVAILABLE includes numeric zero. Other states require null, never imputed zero. Numerator/denominator are explicit quantities, null when absent or inapplicable.",
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      ]
    },
    "ObservationReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^a11-snapshot-[a-f0-9]{64}$"
        },
        "import_id": {
          "type": "string",
          "pattern": "^a09-[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^obs-[a-f0-9]{64}$"
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metric_definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "snapshot_id",
        "import_id",
        "context_sha256",
        "raw_sha256",
        "observation_id",
        "observation_sha256",
        "metric_definition_sha256"
      ]
    },
    "ReportReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^a11-report-[a-f0-9]{64}$"
        }
      },
      "required": [
        "report_id"
      ]
    }
  }
}
