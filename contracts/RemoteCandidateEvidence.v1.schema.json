{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EF02 immutable candidate evidence (publication is not approval)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "review_required", "scope_valid", "out_of_scope_files", "changed_files", "allowed_paths", "candidate_file_sha256", "tracked_diff_sha256", "source_sha", "effective_source_sha", "action_id", "attempt_id", "fingerprint", "verification", "provenance"],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["CANDIDATE_READY", "CANDIDATE_READY_SCOPE_REVIEW"]},
    "review_required": {"type": "boolean"},
    "scope_valid": {"type": "boolean"},
    "out_of_scope_files": {"$ref": "#/$defs/paths"},
    "changed_files": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1},
    "allowed_paths": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1},
    "candidate_file_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}},
    "tracked_diff_sha256": {"$ref": "#/$defs/hash"},
    "source_sha": {"$ref": "#/$defs/sha"},
    "effective_source_sha": {"$ref": "#/$defs/sha"},
    "action_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "fingerprint": {"$ref": "#/$defs/hash"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "exit_code", "profile", "argv", "evidence_sha256", "report_sha256"],
      "properties": {
        "status": {"enum": ["BUILD_VERIFIED_FOR_SCOPE", "VERIFIED_SCOPE_REVIEW_REQUIRED"]},
        "exit_code": {"const": 0},
        "profile": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_sha256": {"type": "object", "minProperties": 1, "required": ["tracked_diff"], "additionalProperties": {"$ref": "#/$defs/hash"}},
        "report_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["executor", "model", "effort", "dependency_candidates", "run_id", "run_attempt"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "dependency_candidates": {"type": "array", "items": {"$ref": "#/$defs/sha"}},
        "run_id": {"type": ["string", "null"]},
        "run_attempt": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "CANDIDATE_READY_SCOPE_REVIEW"}}},
    "then": {"properties": {
      "review_required": {"const": true}, "scope_valid": {"const": false},
      "out_of_scope_files": {"minItems": 1},
      "verification": {"properties": {"status": {"const": "VERIFIED_SCOPE_REVIEW_REQUIRED"}}}
    }},
    "else": {"properties": {
      "review_required": {"const": false}, "scope_valid": {"const": true},
      "out_of_scope_files": {"maxItems": 0},
      "verification": {"properties": {"status": {"const": "BUILD_VERIFIED_FOR_SCOPE"}}}
    }}
  }]
}
