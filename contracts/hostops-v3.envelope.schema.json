{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.invalid/contracts/hostops-v3.envelope.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "hostops.envelope.v3"
    },
    "request": {
      "$ref": "hostops-v3.request.schema.json"
    },
    "issuer_signature_b64": {
      "type": "string",
      "maxLength": 16384
    },
    "lease": {
      "$ref": "hostops-v3.lease.schema.json"
    },
    "lease_signature_b64": {
      "type": "string",
      "maxLength": 16384
    },
    "action_signature_b64": {
      "type": "string",
      "maxLength": 16384
    }
  },
  "required": [
    "schema",
    "request",
    "issuer_signature_b64",
    "lease",
    "lease_signature_b64",
    "action_signature_b64"
  ],
  "additionalProperties": false
}
