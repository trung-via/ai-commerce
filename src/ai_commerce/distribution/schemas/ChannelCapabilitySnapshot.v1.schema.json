{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/ChannelCapabilitySnapshot.v1",
  "title": "ChannelCapabilitySnapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "platform",
    "account_ref",
    "app_ref",
    "market",
    "surface",
    "action",
    "state",
    "constraints",
    "scope_claims",
    "evidence_refs",
    "observed_at",
    "recorded_at",
    "expires_at",
    "source_mode",
    "profile_version"
  ],
  "properties": {
    "schema_version": {
      "const": "ChannelCapabilitySnapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^ccs_[A-Za-z0-9_-]{5,64}$"
    },
    "platform": {
      "enum": [
        "TIKTOK",
        "FACEBOOK",
        "INSTAGRAM",
        "YOUTUBE"
      ]
    },
    "account_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "id"
      ],
      "properties": {
        "namespace": {
          "enum": [
            "tiktok_open_id",
            "facebook_page_id",
            "instagram_user_id",
            "youtube_channel_id",
            "internal_alias"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "app_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "id"
          ],
          "properties": {
            "namespace": {
              "enum": [
                "tiktok_client_key",
                "meta_app_id",
                "google_cloud_project_id",
                "internal_alias"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "market": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "surface": {
      "enum": [
        "VIDEO",
        "REEL",
        "SHORT",
        "PAGE_REEL",
        "PROFILE_VIDEO"
      ]
    },
    "action": {
      "enum": [
        "EXPORT_PACKAGE",
        "MANUAL_POST",
        "API_UPLOAD",
        "API_DIRECT_POST",
        "PUBLIC_VISIBILITY",
        "PRODUCT_ANCHOR",
        "METRICS_READ",
        "SCHEDULE_POST"
      ]
    },
    "state": {
      "enum": [
        "ALLOWED",
        "DENIED",
        "UNKNOWN",
        "EXPIRED",
        "REVOKED",
        "LIMITED"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "scope_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": [
              "GRANTED",
              "NOT_GRANTED",
              "UNKNOWN",
              "REVOKED"
            ]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "integrity",
          "sha256",
          "scope",
          "subject",
          "captured_at"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[A-Za-z0-9_-]{3,64}$"
          },
          "kind": {
            "enum": [
              "PLATFORM_DOC",
              "POLICY_DOC",
              "APP_CONFIGURATION",
              "ACCOUNT_AUTHORIZATION",
              "SCOPE_OBSERVATION",
              "ACCOUNT_STATE_OBSERVATION",
              "MANUAL_ATTESTATION",
              "TEST_FIXTURE"
            ]
          },
          "integrity": {
            "enum": [
              "HASHED",
              "REFERENCE_ONLY"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "enum": [
              "PLATFORM",
              "TARGET"
            ]
          },
          "subject": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "account_ref",
                  "app_ref"
                ],
                "properties": {
                  "account_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "namespace",
                      "id"
                    ],
                    "properties": {
                      "namespace": {
                        "enum": [
                          "tiktok_open_id",
                          "facebook_page_id",
                          "instagram_user_id",
                          "youtube_channel_id",
                          "internal_alias"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  },
                  "app_ref": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "namespace",
                          "id"
                        ],
                        "properties": {
                          "namespace": {
                            "enum": [
                              "tiktok_client_key",
                              "meta_app_id",
                              "google_cloud_project_id",
                              "internal_alias"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ccs_[A-Za-z0-9_-]{5,64}$"
    },
    "source_mode": {
      "enum": [
        "OBSERVED",
        "TEST_FIXTURE"
      ]
    },
    "profile_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    }
  }
}
