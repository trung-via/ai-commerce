{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/PublicationEvent.v1",
  "title": "PublicationEvent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "event_type",
    "provider_post_id",
    "public_url",
    "evidence_sha256",
    "source",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "PublicationEvent.v1"
    },
    "publication_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "SUBMISSION_REPORTED",
        "OUTCOME_UNKNOWN",
        "REJECTION_REPORTED",
        "PUBLICATION_RECEIPT",
        "VISIBILITY_EVIDENCE",
        "REMOVAL_REPORTED"
      ]
    },
    "provider_post_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
