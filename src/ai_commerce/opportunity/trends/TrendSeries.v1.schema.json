{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-commerce.local/schema/TrendSeries.v1",
  "title": "TrendSeries.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "TrendSeries.v1"
    },
    "series_id": {
      "type": "string",
      "pattern": "^series-[a-f0-9]{64}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signal_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "category": {
      "enum": [
        "TOPIC",
        "CREATIVE_FORMAT",
        "UNKNOWN"
      ]
    },
    "comparison_status": {
      "enum": [
        "COMPARABLE",
        "INCOMPARABLE",
        "UNKNOWN"
      ]
    },
    "replay_status": {
      "const": "M01_REPLAY_VERIFIED_AT_BUILD"
    },
    "source_status": {
      "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
    },
    "imports": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "SignalImport.v1"
          },
          "import_id": {
            "type": "string",
            "pattern": "^a10-[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "VALIDATED",
              "IMPORTED"
            ]
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "raw_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "raw_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "format": {
            "enum": [
              "csv",
              "json"
            ]
          },
          "dialect": {
            "enum": [
              "comma",
              "semicolon",
              "tab",
              null
            ]
          },
          "source_snapshot": {
            "$ref": "#/$defs/SignalSourceSnapshot"
          },
          "mapping": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "mapping_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "adapter_version": {
                    "const": "manual-signal.v1"
                  },
                  "native_export_layout_verified": {
                    "const": false
                  },
                  "columns": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                },
                "required": [
                  "profile_id",
                  "mapping_version",
                  "adapter_version",
                  "native_export_layout_verified",
                  "columns"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "context_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lineage": {
            "$ref": "#/$defs/SignalLineage"
          },
          "signal_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "source_status": {
            "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          }
        },
        "required": [
          "schema_version",
          "import_id",
          "status",
          "raw_sha256",
          "raw_ref",
          "raw_size_bytes",
          "format",
          "source_snapshot",
          "context_sha256",
          "scope_sha256",
          "lineage",
          "signal_count",
          "source_status",
          "recorded_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "format": {
                  "const": "json"
                }
              }
            },
            "then": {
              "properties": {
                "dialect": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "dialect": {
                  "enum": [
                    "comma",
                    "semicolon",
                    "tab"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "points": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "TrendSignal.v1"
              },
              "signal_id": {
                "type": "string",
                "pattern": "^sig-[a-f0-9]{64}$"
              },
              "import_id": {
                "type": "string",
                "pattern": "^a10-[a-f0-9]{64}$"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "signal_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "source_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "locale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "geo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "query_context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              "observation_window": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 64
                    },
                    "description": "Explicit instants: start inclusive, end exclusive; never a default period."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "collected_at": {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "denominator": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "AVAILABLE",
                  "NOT_AVAILABLE"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source_status": {
                "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
              },
              "rights_status": {
                "enum": [
                  "UNKNOWN",
                  "USER_DECLARED_PERMITTED",
                  "USER_DECLARED_RESTRICTED",
                  "NOT_APPLICABLE"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "required": [
              "schema_version",
              "signal_id",
              "import_id",
              "ordinal",
              "topic",
              "signal_type",
              "source_type",
              "locale",
              "geo",
              "query_context",
              "observed_at",
              "collected_at",
              "timezone",
              "unit",
              "status",
              "value",
              "source_status",
              "rights_status"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "NOT_AVAILABLE"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            ]
          },
          "comparison_context": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": "TrendComparisonContext.v1"
                  },
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "metric_kind": {
                    "enum": [
                      "COUNT",
                      "RATE",
                      "RELATIVE_INDEX",
                      "UNKNOWN"
                    ]
                  },
                  "baseline_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "normalization_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "query_batch": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "relative_scale": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      }
                    ]
                  },
                  "window_kind": {
                    "enum": [
                      "POINT",
                      "INTERVAL",
                      "UNKNOWN"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "minItems": 1
                  },
                  "source_status": {
                    "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
                  }
                },
                "required": [
                  "schema_version",
                  "metric",
                  "metric_kind",
                  "baseline_id",
                  "normalization_id",
                  "query_batch",
                  "relative_scale",
                  "window_kind",
                  "evidence_refs",
                  "source_status"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "comparison_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unknown_reasons": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "signal",
          "comparison_context",
          "comparison_sha256",
          "unknown_reasons"
        ]
      }
    },
    "cohorts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cohort_id": {
            "type": "string",
            "pattern": "^cohort-[a-f0-9]{64}$"
          },
          "key": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "enum": [
                  "TOPIC",
                  "CREATIVE_FORMAT",
                  "UNKNOWN"
                ]
              },
              "signal_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "source_kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "source_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "scope_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mapping_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metric": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "metric_kind": {
                "enum": [
                  "COUNT",
                  "RATE",
                  "RELATIVE_INDEX",
                  "UNKNOWN"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "denominator": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "query_context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "baseline_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "normalization_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "query_batch": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "relative_scale": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "geo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "locale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "window_kind": {
                "enum": [
                  "POINT",
                  "INTERVAL",
                  "UNKNOWN"
                ]
              },
              "window_offsets_microseconds": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer"
                    }
                  }
                ]
              }
            },
            "required": [
              "topic",
              "category",
              "signal_type",
              "source_id",
              "source_kind",
              "source_type",
              "scope_sha256",
              "mapping_sha256",
              "metric",
              "metric_kind",
              "unit",
              "denominator",
              "query_context",
              "baseline_id",
              "normalization_id",
              "query_batch",
              "relative_scale",
              "geo",
              "locale",
              "timezone",
              "window_kind",
              "window_offsets_microseconds"
            ]
          },
          "signal_ids": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "pattern": "^sig-[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "cohort_id",
          "key",
          "signal_ids"
        ]
      }
    },
    "excluded_signal_ids": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^sig-[a-f0-9]{64}$"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "required": [
    "schema_version",
    "series_id",
    "topic",
    "signal_type",
    "category",
    "comparison_status",
    "replay_status",
    "source_status",
    "imports",
    "points",
    "cohorts",
    "excluded_signal_ids",
    "limitations"
  ],
  "$defs": {
    "SignalSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "SignalSourceSnapshot.v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_status": {
          "enum": [
            "UNKNOWN",
            "USER_DECLARED_PERMITTED",
            "USER_DECLARED_RESTRICTED",
            "NOT_APPLICABLE"
          ]
        },
        "verification_status": {
          "const": "USER_SUPPLIED_NOT_LIVE_VERIFIED"
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "geo": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "locale": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "source_kind",
        "source_ref",
        "captured_at",
        "sha256",
        "rights_status",
        "verification_status"
      ]
    },
    "SignalLineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship": {
          "enum": [
            "ORIGINAL",
            "CORRECTION",
            "REPROCESS"
          ]
        },
        "parent_import_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^a10-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relationship",
        "parent_import_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "relationship": {
                "const": "ORIGINAL"
              }
            }
          },
          "then": {
            "properties": {
              "parent_import_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "parent_import_id": {
                "type": "string",
                "pattern": "^a10-[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
